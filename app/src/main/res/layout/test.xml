            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="11" android:textColor="#000000" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="Fig" android:textColor="#000000" android:typeface="serif" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="60 kg" android:textColor="#000000" android:typeface="serif" />
