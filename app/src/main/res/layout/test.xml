            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="10" android:textColor="#000000" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="Orange" android:textColor="#000000" android:typeface="serif" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="20 kg" android:textColor="#000000" android:typeface="serif" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="Yes" android:textColor="#000000" android:typeface="serif" />
