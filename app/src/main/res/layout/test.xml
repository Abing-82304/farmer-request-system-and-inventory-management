            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="10 kg" android:textColor="#000000" android:typeface="serif" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="No" android:textColor="#000000" android:typeface="serif" />
        </TableRow>

